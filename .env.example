# Copy to .env and adjust. Real environment variables override this file.
APP_ENV=development
APP_LABEL=ATLAS LOCAL
HOST=127.0.0.1
PORT=4190
# SQLite database file (created automatically). Default: data/atlas.sqlite
# DATABASE_FILE=data/atlas.sqlite
# A long random secret. Changing it later invalidates every password.
PASSWORD_PEPPER=replace-with-a-long-random-secret-of-at-least-32-characters
SESSION_TTL_SECONDS=28800
PUBLIC_ORIGIN=http://localhost:4190
SECURE_COOKIES=false
TRUST_PROXY=false
# Currency used for shareholder profit distribution.
BASE_CURRENCY=USD
# Used by "npm run db:seed". LOCAL DEMO passwords only; refused when APP_ENV=production.
SEED_OWNER_EMAIL=owner@atlas.local
SEED_OWNER_PASSWORD=Demo-only-password-1
SEED_DEMO_PASSWORD=Demo-only-password-1
